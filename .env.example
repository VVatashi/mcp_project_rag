# MCP transport
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3123
MCP_HTTP_PATH=/mcp

# Local storage
MCP_DATA_DIR=./data

# ChromaDB
CHROMA_URL=http://127.0.0.1:8000

# Local models
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RERANK_MODEL=Xenova/all-MiniLM-L6-v2

# Context assembly
MAX_CONTEXT_CHARS=12000
