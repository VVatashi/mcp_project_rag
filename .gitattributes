# Normalize line endings on commit, check out native
* text=auto

# Source and config files
*.cs text diff=csharp
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.slnx text eol=crlf
*.sln text eol=crlf
*.json text
*.md text
*.xml text
*.yml text
*.yaml text
*.editorconfig text
*.gitattributes text
*.gitignore text

# Scripts keep their platform endings
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.snk binary
*.nupkg binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
