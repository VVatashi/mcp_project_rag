{
  "name": "mcp-project-rag-server",
  "version": "0.1.0",
  "description": "Local multi-project RAG MCP server for codebases backed by ChromaDB.",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "pretest": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev:http": "tsx src/index.ts --transport=http",
    "dev:stdio": "tsx src/index.ts --transport=stdio",
    "start": "node dist/src/index.js",
    "test": "vitest run tests --pool=threads --exclude tests/**/*.spec.ts",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "mcp",
    "rag",
    "chromadb",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@xenova/transformers": "^2.17.2",
    "chromadb": "^3.4.0",
    "fastify": "^5.8.4",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "pino": "^10.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
